# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/predictive_maintenance_dev

# Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Python FastAPI ML Service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=4000
MOCK_ML_SERVICE=false

# Machine Priority Engine Weights (Must sum to ~1.0)
PRIORITY_WEIGHT_RISK=0.50
PRIORITY_WEIGHT_CRITICALITY=0.25
PRIORITY_WEIGHT_COST=0.15
PRIORITY_WEIGHT_RECENCY=0.10
BENCHMARK_MAX_DOWNTIME_COST=10000
